{% from pathjoin('includes', 'slug.jinja') import slugify %}
{%- set package_slug = slugify(project_name) | replace('_', '-') | trim -%}
{
  "name": "{{ package_slug }}-frontend",
  "version": "{{ project_version }}",
  "private": true,
  "packageManager": "pnpm@10.32.1",
  "engines": {
    "node": ">=18.0.0"
  },
  "scripts": {
    "bootstrap": "node ./package-scripts.js bootstrap",
    "dev": "vite",
    "build": "vite build && node ./package-scripts.js package",
    "deploy": "node ./package-scripts.js deploy",
    "package": "node ./package-scripts.js package",
    "type-check": "tsc --noEmit",
    "lint": "eslint \"src/**/*.{ts,tsx}\"",
    "test": "vitest run",
    "watch": "vite build --watch"
  },
  "dependencies": {
    "react": "19.2.4",
    "react-dom": "19.2.4"
  },
  "devDependencies": {
    "@eslint/js": "9.39.4",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.2",
    "@testing-library/user-event": "14.6.1",
    "@types/node": "22.19.17",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "4.7.0",
    "archiver": "4.0.2",
    "chalk": "4.1.2",
    "eslint": "9.39.4",
    "eslint-plugin-react-hooks": "5.2.0",
    "eslint-plugin-react-refresh": "0.4.26",
    "formdata-node": "2.5.0",
    "globals": "17.4.0",
    "inquirer": "7.3.3",
    "jsdom": "26.1.0",
    "mkdirp": "1.0.4",
    "node-fetch": "2.7.0",
    "rimraf": "3.0.2",
    "typescript": "5.9.3",
    "typescript-eslint": "8.58.0",
    "vite": "6.4.2",
    "vitest": "3.2.4"
  }
}
