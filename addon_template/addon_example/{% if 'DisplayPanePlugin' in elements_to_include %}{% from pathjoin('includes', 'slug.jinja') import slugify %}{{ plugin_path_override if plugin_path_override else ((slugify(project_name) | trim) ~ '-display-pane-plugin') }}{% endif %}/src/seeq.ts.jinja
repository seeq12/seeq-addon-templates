const SDK_SCRIPT_ID = "seeq-plugin-sdk";
const SDK_SCRIPT_SRC = "/api/plugins/sdk/seeq.js";

export interface SeeqApi {
  pluginRenderComplete?: () => void;
}

declare global {
  function getSeeqApi(): Promise<SeeqApi>;
}

let seeqPromise: Promise<SeeqApi> | null = null;

export function getSeeq(): Promise<SeeqApi> {
  if (!seeqPromise) {
    seeqPromise = loadSeeqSdk().then(() => getSeeqApi());
  }

  return seeqPromise;
}

function loadSeeqSdk(): Promise<void> {
  if (typeof getSeeqApi === "function") {
    return Promise.resolve();
  }

  const existingScript = document.getElementById(SDK_SCRIPT_ID) as HTMLScriptElement | null;
  if (existingScript) {
    return waitForSeeqSdk();
  }

  return new Promise((resolve, reject) => {
    const script = document.createElement("script");
    script.id = SDK_SCRIPT_ID;
    script.src = SDK_SCRIPT_SRC;
    script.async = true;
    script.onload = () => {
      waitForSeeqSdk().then(resolve).catch(reject);
    };
    script.onerror = () => {
      reject(new Error(`Failed to load Seeq SDK from ${SDK_SCRIPT_SRC}`));
    };
    document.head.appendChild(script);
  });
}

function waitForSeeqSdk(): Promise<void> {
  return new Promise((resolve, reject) => {
    let attempts = 0;

    const check = () => {
      if (typeof getSeeqApi === "function") {
        resolve();
        return;
      }

      attempts += 1;
      if (attempts > 100) {
        reject(new Error("Seeq SDK loaded, but getSeeqApi was not registered."));
        return;
      }

      window.setTimeout(check, 20);
    };

    check();
  });
}
