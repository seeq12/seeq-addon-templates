{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Seeq Add-on",
  "type": "object",
  "required": [
    "identifier",
    "name",
    "description",
    "version",
    "maintainer",
    "license",
    "elements"
  ],
  "properties": {
    "identifier": {
      "type": "string",
      "minLength": 1
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "description": {
      "type": "string"
    },
    "version": {
      "type": "string",
      "minLength": 1
    },
    "maintainer": {
      "type": "string",
      "minLength": 1
    },
    "license": {
      "type": "string",
      "minLength": 1
    },
    "icon": {
      "type": "string",
      "default": "fa-bar-chart"
    },
    "elements": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "identifier",
          "name",
          "type",
          "path"
        ],
        "properties": {
          "identifier": {
            "type": "string",
            "minLength": 1
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "type": {
            "type": "string",
            "enum": [
              "Plugin",
              "DataLabFunctions"
            ]
          },
          "category": {
            "type": "string",
            "enum": [
              "DisplayPane"
            ]
          },
          "path": {
            "type": "string",
            "minLength": 1
          },
          "configuration_schema": {
            "type": "object"
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "type": {
                  "const": "Plugin"
                }
              }
            },
            "then": {
              "required": [
                "category"
              ]
            }
          }
        ]
      }
    }
  }
}
